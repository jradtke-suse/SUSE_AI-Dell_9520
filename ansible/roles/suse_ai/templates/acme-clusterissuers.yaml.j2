{% for name, server in acme_servers.items() %}
---
apiVersion: cert-manager.io/v1
kind: ClusterIssuer
metadata:
  name: {{ name }}
spec:
  acme:
    server: {{ server }}
    privateKeySecretRef:
      name: {{ name }}-account-key
    solvers:
      - selector:
          dnsZones:
            - {{ acme_dns_zone }}
        dns01:
          route53:
            region: {{ acme_route53_region }}
            hostedZoneID: {{ acme_route53_zone_id }}
            accessKeyID: {{ route53_access_key_id }}
            secretAccessKeySecretRef:
              name: route53-credentials
              key: secret-access-key
{% endfor %}
