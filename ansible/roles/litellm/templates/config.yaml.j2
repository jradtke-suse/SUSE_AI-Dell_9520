# Managed by Ansible (litellm role)
model_list:
{% for m in litellm_models %}
  - model_name: "{{ m.name }}"
    litellm_params:
      model: "{{ m.model }}"
      api_base: "{{ m.api_base }}"
{% endfor %}

general_settings:
  master_key: os.environ/LITELLM_MASTER_KEY
  database_url: os.environ/DATABASE_URL
