---
# Create the real file with:  ansible-vault create group_vars/all/vault.yml
vault_scc_regcode: "XXXXXXXXXXXXXX"
vault_scc_email: "you@example.com"
vault_suse_ai_regcode: "XXXXXXXXXXXXXX"   # optional, only if SUSE AI is an SCC extension
# SUSE Application Collection (https://apps.rancher.io): username/email + access token
vault_appco_username: "you@suse.com"   # AppCo login, may differ from the SCC email
vault_appco_token: "XXXXXXXXXXXXXX"
# WiFi PSKs
vault_wifi_kubernerdes_psk: "XXXXXXXX"

vault_route53_access_key_id: "AKIAXXXXXXXXXXXXXXXX"
vault_route53_secret_access_key: "XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
